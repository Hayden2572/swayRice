### =========================================================
### WEXP SWAY RICE — stable base
### =========================================================

set $mod Mod4
set $term kitty
set $term_tmux /home/wexp/.local/bin/ktmux
set $menu rofi -show drun -show-icons -theme ~/.config/rofi/theme.rasi
set $lock /home/wexp/.local/bin/lockscreen

font pango:JetBrainsMono Nerd Font 10


### =========================================================
### AUTOSTART
### =========================================================
# Export Sway/Wayland env for user systemd services
exec_always --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS PATH
exec_always --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS
# Autotiling: new windows open in balanced spiral-like layout
exec_always --no-startup-id /home/wexp/.local/bin/sway-autotiling

# Waybar reload without duplicates
exec_always --no-startup-id sh -c 'pkill waybar; waybar'

# Notifications
exec_always --no-startup-id sh -c 'pkill dunst; dunst'

# Network tray applet
exec --no-startup-id nm-applet --indicator

# Polkit agent for GUI password prompts
exec --no-startup-id sh -c 'pgrep -f polkit-kde-authentication-agent-1 >/dev/null || /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 || /usr/lib/polkit-kde-authentication-agent-1'

# Dark solid background
output * bg ~/Pictures/wallpapers/blueAbstract4K.jpg fill

# Idle lock
# Idle / sleep lock
exec_always --no-startup-id sh -c 'pkill swayidle; swayidle -w \
  timeout 900 "/home/wexp/.local/bin/lockscreen" \
  timeout 1200 "swaymsg output \"*\" power off" \
  resume "swaymsg output \"*\" power on" \
  before-sleep "/home/wexp/.local/bin/lockscreen" \
  >/tmp/swayidle.log 2>&1 &'

### =========================================================
### VISUAL STYLE
### =========================================================

default_border pixel 1
default_floating_border pixel 1

hide_edge_borders smart
smart_borders on

gaps inner 10
gaps outer 8

client.focused          #8BD5CA #101219 #DCE0E8 #8BD5CA #8BD5CA
client.focused_inactive #303446 #101219 #A6ADC8 #303446 #303446
client.unfocused        #1E1E2E #0B0D12 #6C7086 #1E1E2E #1E1E2E
client.urgent           #ED8796 #1E1E2E #FFFFFF #ED8796 #ED8796

for_window [app_id="kitty"] border pixel 1
for_window [class="kitty"] border pixel 1

# Disable default swaybar. We use waybar.
bar {
    mode invisible
}


### =========================================================
### INPUT
### =========================================================

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    pointer_accel 0.2
}

input type:keyboard {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}


### =========================================================
### KEYBINDS
### =========================================================
bindsym --to-code $mod+Escape exec $lock
# Bluetooth menu
bindsym --to-code $mod+Shift+b exec /home/wexp/.local/bin/bt-menu

# Wi-Fi connect menu
bindsym --to-code $mod+Shift+w exec /home/wexp/.local/bin/wifi-connect

bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+Shift+Return exec $term_tmux
bindsym --to-code $mod+d exec $menu

bindsym --to-code $mod+q kill
bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+e exec ~/.local/bin/powermenu

bindsym --to-code $mod+f fullscreen toggle
bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+space focus mode_toggle

# Focus windows
bindsym --to-code $mod+h focus left
bindsym --to-code $mod+j focus down
bindsym --to-code $mod+k focus up
bindsym --to-code $mod+l focus right

bindsym --to-code $mod+Left focus left
bindsym --to-code $mod+Down focus down
bindsym --to-code $mod+Up focus up
bindsym --to-code $mod+Right focus right

# Move windows
bindsym --to-code $mod+Shift+h move left
bindsym --to-code $mod+Shift+j move down
bindsym --to-code $mod+Shift+k move up
bindsym --to-code $mod+Shift+l move right

bindsym --to-code $mod+Shift+Left move left
bindsym --to-code $mod+Shift+Down move down
bindsym --to-code $mod+Shift+Up move up
bindsym --to-code $mod+Shift+Right move right

# Split
bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv

# Layout
bindsym --to-code $mod+w layout tabbed
# Mod + E — terminal file manager
bindsym --to-code $mod+e exec /home/wexp/.local/bin/kfm

# Layout toggle moved here
bindsym --to-code $mod+Shift+v layout toggle split
### =========================================================
### RESIZE MODE
### =========================================================

bindsym --to-code $mod+r mode "resize"

mode "resize" {
    bindsym --to-code h resize shrink width 10px
    bindsym --to-code j resize grow height 10px
    bindsym --to-code k resize shrink height 10px
    bindsym --to-code l resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### =========================================================
### WORKSPACES
### =========================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

# Switch workspace
bindsym --to-code $mod+1 workspace number $ws1
bindsym --to-code $mod+2 workspace number $ws2
bindsym --to-code $mod+3 workspace number $ws3
bindsym --to-code $mod+4 workspace number $ws4
bindsym --to-code $mod+5 workspace number $ws5
bindsym --to-code $mod+6 workspace number $ws6
bindsym --to-code $mod+7 workspace number $ws7
bindsym --to-code $mod+8 workspace number $ws8
bindsym --to-code $mod+9 workspace number $ws9

# Move active window to workspace
bindsym --to-code $mod+Shift+1 move container to workspace number $ws1
bindsym --to-code $mod+Shift+2 move container to workspace number $ws2
bindsym --to-code $mod+Shift+3 move container to workspace number $ws3
bindsym --to-code $mod+Shift+4 move container to workspace number $ws4
bindsym --to-code $mod+Shift+5 move container to workspace number $ws5
bindsym --to-code $mod+Shift+6 move container to workspace number $ws6
bindsym --to-code $mod+Shift+7 move container to workspace number $ws7
bindsym --to-code $mod+Shift+8 move container to workspace number $ws8
bindsym --to-code $mod+Shift+9 move container to workspace number $ws9

### =========================================================
### SCREENSHOTS
### =========================================================

# Mod + S — screenshot of focused monitor to clipboard
bindsym --to-code $mod+s exec grim -o "$(swaymsg -t get_outputs | jq -r '.[] | select(.focused).name')" - | wl-copy

# Mod + Shift + S — select area and copy to clipboard
bindsym --to-code $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

# Optional old binds
bindsym Print exec grim - | wl-copy
bindsym --to-code $mod+Print exec grim -g "$(slurp)" - | wl-copy

### =========================================================
### AUDIO / BRIGHTNESS
### =========================================================

bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
