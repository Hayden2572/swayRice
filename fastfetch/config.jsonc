{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
  "type": "file-raw",
  "source": "~/.config/fastfetch/logos/skull.txt",
  "color": {
    "1": "white"
  },
  "padding": {
    "top": 2,
    "left": 3,
    "right": 6
  }
},

  "display": {
    "separator": ": ",
    "constants": [
      "──────────────────────────────────────────────"
    ]
  },

  "modules": [
    "break",

    {
      "type": "custom",
      "format": "╭─ 󰌢 HOST {$1}╮",
      "outputColor": "38;2;143;188;187"
    },
    {
      "type": "board",
      "key": "│ 󰘚 Motherboard",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│  Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Disk (/)",
      "folders": "/",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "╰{$1}╯",
      "outputColor": "38;2;143;188;187"
    },

    "break",

    {
      "type": "custom",
      "format": "╭─ 󰅐 RUNTIME {$1}╮",
      "outputColor": "38;2;143;188;187"
    },
    {
      "type": "os",
      "key": "│  OS",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": "│ 󰔚 OS Age",
      "keyColor": "green",
      "text": "birth=$(stat -c %W / 2>/dev/null); now=$(date +%s); if [ \"$birth\" -gt 0 ]; then echo $(( (now-birth)/86400 )) days; else echo n/a; fi"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "│ 󰖲 WM",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "│  Terminal",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "╰{$1}╯",
      "outputColor": "38;2;143;188;187"
    }
  ]
}
