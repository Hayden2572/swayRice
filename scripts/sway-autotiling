#!/usr/bin/env python3

import os
import sys
import atexit
from pathlib import Path

try:
    import i3ipc
except ImportError:
    print("Missing python3-i3ipc. Install: sudo apt install python3-i3ipc", file=sys.stderr)
    sys.exit(1)

runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
pidfile = Path(runtime) / "sway-autotiling.pid"

if pidfile.exists():
    try:
        old_pid = int(pidfile.read_text().strip())
        os.kill(old_pid, 0)
        sys.exit(0)
    except Exception:
        pass

pidfile.write_text(str(os.getpid()))

def cleanup():
    try:
        pidfile.unlink()
    except FileNotFoundError:
        pass

atexit.register(cleanup)

sway = i3ipc.Connection()

def is_floating(node):
    try:
        return node.floating and node.floating != "auto_off"
    except Exception:
        return False

def autotile(_i3=None, _event=None):
    try:
        tree = sway.get_tree()
        focused = tree.find_focused()

        if focused is None:
            return

        if focused.type not in ("con", "floating_con"):
            return

        if is_floating(focused):
            return

        rect = focused.rect

        if rect.width >= rect.height:
            sway.command("splith")
        else:
            sway.command("splitv")

    except Exception as e:
        print(f"autotiling error: {e}", file=sys.stderr)

sway.on("window::focus", autotile)
sway.on("window::new", autotile)
sway.on("workspace::focus", autotile)

autotile()
sway.main()
